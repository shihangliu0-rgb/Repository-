<?xml version="1.0"?>
<!--
  第 07 课：可仿真的差速机器人（在 06 课模型基础上增加）。

  相比纯可视化模型，多了三块内容：
    A. <ros2_control>      —— 声明两个轮子的「速度指令接口 + 位置/速度状态接口」
    B. <gazebo> 插件       —— gz_ros2_control 系统插件，在 Gazebo 里实例化 controller_manager，
                              并读取 learn_gazebo/config/learnbot_controllers.yaml
    C. gpu_lidar 传感器    —— 真实的 2D 激光雷达，通过 /scan 话题输出

  注意轮距（wheel_separation）必须与控制器 YAML 里的数值一致！
-->
<robot name="learning_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== 尺寸参数 ========== -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.20"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="1.5"/>

  <xacro:property name="wheel_radius"   value="0.05"/>
  <xacro:property name="wheel_width"    value="0.02"/>
  <xacro:property name="wheel_mass"     value="0.1"/>
  <xacro:property name="wheel_xoff"     value="0.08"/>
  <!-- 轮距 = 底盘宽 + 轮宽，控制器 YAML 必须写同一个值 -->
  <xacro:property name="wheel_separation" value="${chassis_width + wheel_width}"/>

  <xacro:property name="caster_radius"  value="0.03"/>
  <xacro:property name="caster_mass"    value="0.05"/>

  <xacro:property name="lidar_radius"   value="0.035"/>
  <xacro:property name="lidar_height"   value="0.03"/>
  <xacro:property name="lidar_mass"     value="0.05"/>

  <!-- ========== 惯量宏 ========== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
        iyy="${2.0*m*r*r/5.0}" iyz="0.0"
        izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ========== 轮子宏 ========== -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_xoff} ${y_reflect*(chassis_width/2.0 + wheel_width/2.0)} ${-(chassis_height/2.0) + wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- ========== 材质 ========== -->
  <material name="blue">  <color rgba="0.2 0.4 0.8 1.0"/> </material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1.0"/> </material>
  <material name="red">   <color rgba="0.8 0.1 0.1 1.0"/> </material>
  <material name="grey">  <color rgba="0.5 0.5 0.5 1.0"/> </material>

  <!-- ========== 主体 ========== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + chassis_height/2.0}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <xacro:wheel prefix="left"  y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- 万向轮（低摩擦，仿真里负责第三点支撑） -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${-chassis_length/2.0 + caster_radius + 0.02} 0 ${-(chassis_height/2.0) - (wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <!-- 激光雷达 -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${chassis_length/2.0 - lidar_radius - 0.03} 0 ${chassis_height/2.0 + lidar_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- =====================================================================
       A. ros2_control：把两个轮子的速度暴露成可被控制器驱动的接口
       ===================================================================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- =====================================================================
       B. gz_ros2_control 系统插件：在 Gazebo 里加载 controller_manager。
          控制器配置在 learn_gazebo/config/learnbot_controllers.yaml。
          用 <ros><remapping> 把控制器内部的指令话题统一重映射成 /cmd_vel，
          这样键盘遥控、Nav2 都能直接往 /cmd_vel 发布。
       ===================================================================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find learn_gazebo)/config/learnbot_controllers.yaml</parameters>
      <ros>
        <remapping>diff_drive_base_controller/cmd_vel_unstamped:=cmd_vel</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- =====================================================================
       C. gpu_lidar 激光雷达。输出在 Gazebo 的 /scan 话题上，
          再由 ros_gz_bridge 桥接到 ROS 2 的 /scan。
          <gz_frame_id> 决定 LaserScan 的 frame_id（与 TF 里的 lidar_link 对齐）。
       ===================================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- 降低万向轮摩擦，避免干扰差速运动学 -->
  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

</robot>
